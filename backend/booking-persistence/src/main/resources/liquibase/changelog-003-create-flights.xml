<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="003-create-flights" author="booking-team">
        <createTable tableName="flights">
            <column name="id" type="VARCHAR(50)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="flight_number" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="marketing_airline" type="VARCHAR(10)">
                <constraints nullable="false"/>
            </column>
            <column name="departure_airport" type="VARCHAR(10)">
                <constraints nullable="false"/>
            </column>
            <column name="arrival_airport" type="VARCHAR(10)">
                <constraints nullable="false"/>
            </column>
            <column name="departure_time" type="DATETIME">
                <constraints nullable="false"/>
            </column>
            <column name="arrival_time" type="DATETIME">
                <constraints nullable="false"/>
            </column>
            <column name="travel_time_minutes" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="stops" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="available_seats" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="price_amount" type="DECIMAL(10,2)">
                <constraints nullable="false"/>
            </column>
            <column name="price_currency" type="VARCHAR(3)" defaultValue="EUR">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(30)" defaultValue="AVAILABLE">
                <constraints nullable="false"/>
            </column>
            <column name="cached_at" type="TIMESTAMP"/>
        </createTable>

        <createIndex tableName="flights" indexName="idx_flight_route_date">
            <column name="departure_airport"/>
            <column name="arrival_airport"/>
            <column name="departure_time"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
