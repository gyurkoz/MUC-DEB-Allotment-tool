<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="002-create-bookings" author="booking-team">
        <createTable tableName="bookings">
            <column name="id" type="CHAR(36)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="user_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_booking_user"
                             references="users(id)"/>
            </column>
            <column name="pnr" type="VARCHAR(10)"/>
            <column name="status" type="VARCHAR(30)">
                <constraints nullable="false"/>
            </column>
            <column name="flight_id" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="flight_number" type="VARCHAR(20)"/>
            <column name="marketing_airline" type="VARCHAR(10)"/>
            <column name="departure_airport" type="VARCHAR(10)"/>
            <column name="arrival_airport" type="VARCHAR(10)"/>
            <column name="departure_time" type="DATETIME"/>
            <column name="arrival_time" type="DATETIME"/>
            <column name="travel_time_minutes" type="INT"/>
            <column name="stops" type="INT"/>
            <column name="price_amount" type="DECIMAL(10,2)"/>
            <column name="price_currency" type="VARCHAR(3)"/>
            <column name="passenger_u_number" type="VARCHAR(20)"/>
            <column name="passenger_first_name" type="VARCHAR(50)"/>
            <column name="passenger_last_name" type="VARCHAR(50)"/>
            <column name="passenger_email" type="VARCHAR(255)"/>
            <column name="passenger_phone_number" type="VARCHAR(50)"/>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP"/>
        </createTable>

        <createIndex tableName="bookings" indexName="idx_booking_status">
            <column name="status"/>
        </createIndex>
        <createIndex tableName="bookings" indexName="idx_booking_user_id">
            <column name="user_id"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
